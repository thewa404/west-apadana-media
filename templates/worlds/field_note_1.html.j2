<!doctype html><html><head><meta charset="utf-8"><style>
{{ font_css }}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:{{ sw*n }}px;height:{{ sh }}px;overflow:hidden;background:{{ c.ivory }};color:{{ c.obsidian }}}
.s{position:absolute;top:0;width:{{ sw }}px;height:{{ sh }}px;overflow:hidden}
.fld{position:absolute;left:0;top:121px;width:{{ sw }}px;height:1113px;overflow:hidden}
.mono{font-family:'DM Mono';font-weight:500;text-transform:uppercase;letter-spacing:.14em;font-size:28px}
.gd{color:{{ extra.gold_deep }}}
.serif{font-family:'DM Serif Display'}
.it{font-style:italic}
.ib{font-family:'Inter Display';font-weight:700;letter-spacing:-.03em}
.abs{position:absolute}
.num{position:absolute;font-family:'DM Serif Display';color:transparent;-webkit-text-stroke:3px {{ extra.gold_deep }};line-height:.78}
.weak{font:500 40px/1.15 'Inter Display';color:{{ c.graphite }};position:relative;display:inline-block;letter-spacing:-.01em}
.weak:after{content:'';position:absolute;left:-8px;right:-8px;top:54%;height:5px;background:{{ extra.gold_deep }};transform:rotate(-1.2deg)}
.strong{font:italic 400 60px/1.1 'DM Serif Display';letter-spacing:-.01em}
.strong u{text-decoration:none;background:linear-gradient({{ extra.gold_deep }},{{ extra.gold_deep }}) 0 100%/100% 4px no-repeat;padding-bottom:5px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.tag{font:500 28px 'DM Mono';text-transform:uppercase;letter-spacing:.14em;color:{{ extra.gold_deep }};margin-bottom:12px}
#rule{position:absolute;left:0;top:118px;width:{{ sw*n }}px;height:2px;background:{{ c.obsidian }}}
#ruler{position:absolute;left:0;top:1236px;width:{{ sw*n }}px;height:46px}
#grain{position:absolute;inset:0;background:url('file://{{ grain }}');opacity:.075;mix-blend-mode:multiply;pointer-events:none}
#ink{position:absolute;left:0;top:0;width:{{ sw*n }}px;height:{{ sh }}px;pointer-events:none}
.q{font:700 118px/.98 'Inter Display';letter-spacing:-.04em}
.chk{display:flex;align-items:center;gap:34px;border-top:2px solid {{ c.obsidian }};padding:20px 0 18px}
.chk b{font:700 58px/1 'Inter Display';letter-spacing:-.03em}
.chk span.sub{display:block;font:400 32px/1.3 'DM Sans';color:{{ c.graphite }};margin-top:6px;letter-spacing:0}
</style></head><body>

{# ---------- slide 1: cover ---------- #}
<div class="s" style="left:0">
  <div class="abs mono" style="left:72px;top:64px">Field Note № 01</div>
  <div class="abs mono" style="right:72px;top:64px">1 / 7</div>
  <div class="abs serif" style="left:72px;top:200px;font-size:132px;line-height:.97;letter-spacing:-.022em">Four questions<br>every homepage<br>answers, <span id="inorder" class="it gd" style="display:inline-block">in&nbsp;order.</span></div>
  <div class="abs serif it gd" style="left:72px;top:690px;width:560px;font-size:44px;line-height:1.18;border-left:3px solid {{ extra.gold_deep }};padding-left:26px">Most sites answer the last one first.</div>
  <div class="abs serif" style="left:60px;top:870px;font-size:300px;line-height:.8;letter-spacing:.02em;color:transparent;-webkit-text-stroke:3px {{ extra.gold_deep }}">1 2 3 4</div>
  <div class="abs mono" style="left:72px;top:1290px">Swipe →</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 2: question 1 (the second hook) ---------- #}
<div class="s" style="left:{{ sw }}px">
  <div class="abs mono" style="left:72px;top:64px">Question 1 of 4</div>
  <div class="abs mono" style="right:72px;top:64px">2 / 7</div>
  <div class="fld"><div class="num" style="left:-70px;top:60px;font-size:980px">1</div></div>
  <div class="abs q" style="left:330px;top:230px">What<br>is this?</div>
  <div class="abs" style="left:330px;top:640px;width:690px">
    <div class="tag">What most sites say</div><div class="weak">Welcome to our website.</div>
  </div>
  <div class="abs" style="left:330px;top:850px;width:690px">
    <div class="tag">What a stranger needs</div><div class="strong"><u>We fix bikes</u><br><u>while you wait.</u></div>
  </div>
  <div class="abs mono" style="left:72px;top:1290px">An invented example</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 3: question 2 ---------- #}
<div class="s" style="left:{{ sw*2 }}px">
  <div class="abs mono" style="left:72px;top:64px">Question 2 of 4</div>
  <div class="abs mono" style="right:72px;top:64px">3 / 7</div>
  <div class="fld"><div class="num" style="right:-90px;top:-70px;font-size:960px">2</div></div>
  <div class="abs" style="left:72px;top:230px;width:520px">
    <div class="tag">What most sites say</div><div class="weak">Solutions for everyone.</div>
  </div>
  <div class="abs q" style="left:72px;top:620px">Is it<br>for me?</div>
  <div class="abs" style="left:72px;top:960px;width:860px">
    <div class="tag">What a stranger needs</div><div class="strong"><u>Fast repairs for people</u><br><u>who ride to work.</u></div>
  </div>
  <div class="abs mono" style="left:72px;top:1290px">An invented example</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 4: question 3 ---------- #}
<div class="s" style="left:{{ sw*3 }}px">
  <div class="abs mono" style="left:72px;top:64px">Question 3 of 4</div>
  <div class="abs mono" style="right:72px;top:64px">4 / 7</div>
  <div class="fld"><div class="num" style="right:90px;top:668px;font-size:560px">3</div></div>
  <div class="abs q" style="left:72px;top:190px">Can I<br>trust it?</div>
  <div class="abs" style="left:72px;top:450px;width:700px">
    <div class="tag">What most sites say</div><div class="weak">We are passionate about quality.</div>
  </div>
  <div class="abs" style="left:72px;top:610px;width:930px">
    <div class="tag">What a stranger needs</div><div class="strong"><u>Prices on the page. Photos of</u><br><u>the real shop. A number you can call.</u></div>
  </div>
  <div class="abs mono" style="left:72px;top:1290px">An invented example</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 5: question 4 ---------- #}
<div class="s" style="left:{{ sw*4 }}px">
  <div class="abs mono" style="left:72px;top:64px">Question 4 of 4</div>
  <div class="abs mono" style="right:72px;top:64px">5 / 7</div>
  <div class="fld"><div class="num" style="right:-80px;top:260px;font-size:960px">4</div></div>
  <div class="abs q" style="left:72px;top:200px">What do I<br>do next?</div>
  <div class="abs" style="left:72px;top:600px;width:560px">
    <div class="tag">What most sites say</div><div class="weak">Click here to learn more.</div>
  </div>
  <div class="abs" style="left:72px;top:830px;width:560px">
    <div class="tag">What a stranger needs</div><div class="strong"><u>Book a repair.</u><br><u>One button,</u><br><u>top right.</u></div>
  </div>
  <div class="abs mono" style="left:72px;top:1290px">An invented example</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 6: run it on your own site ---------- #}
<div class="s" style="left:{{ sw*5 }}px">
  <div class="abs mono" style="left:72px;top:64px">Your turn</div>
  <div class="abs mono" style="right:72px;top:64px">6 / 7</div>
  <div class="abs serif" style="left:72px;top:190px;font-size:112px;line-height:.98;letter-spacing:-.02em">Run it on<br><span class="it gd">your own site.</span></div>
  <div class="abs" style="left:72px;top:450px;width:936px">
    <div class="chk"><svg width="64" height="64" viewBox="0 0 64 64"><rect x="4" y="4" width="56" height="56" fill="none" stroke="{{ c.obsidian }}" stroke-width="3" rx="4"/></svg><div><b>What is this?</b><span class="sub">Said plainly, in the first line.</span></div></div>
    <div class="chk"><svg width="64" height="64" viewBox="0 0 64 64"><rect x="4" y="4" width="56" height="56" fill="none" stroke="{{ c.obsidian }}" stroke-width="3" rx="4"/></svg><div><b>Is it for me?</b><span class="sub">The right visitor can tell at a glance.</span></div></div>
    <div class="chk"><svg width="64" height="64" viewBox="0 0 64 64"><rect x="4" y="4" width="56" height="56" fill="none" stroke="{{ c.obsidian }}" stroke-width="3" rx="4"/></svg><div><b>Can I trust it?</b><span class="sub">Proof a stranger can check.</span></div></div>
    <div class="chk" style="border-bottom:2px solid {{ c.obsidian }}"><svg width="64" height="64" viewBox="0 0 64 64"><rect x="4" y="4" width="56" height="56" fill="none" stroke="{{ c.obsidian }}" stroke-width="3" rx="4"/></svg><div><b>What do I do next?</b><span class="sub">One clear action.</span></div></div>
  </div>
  <div class="abs serif it" style="left:72px;top:1075px;width:900px;font-size:42px;line-height:1.2">Cover everything below the first screen. Can a stranger answer all four? Fix them in order.</div>
  <div class="abs mono" style="left:72px;top:1290px">Swipe →</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

{# ---------- slide 7: save ---------- #}
<div class="s" style="left:{{ sw*6 }}px">
  <div class="abs mono" style="left:72px;top:64px">Field Note № 01</div>
  <div class="abs mono" style="right:72px;top:64px">7 / 7</div>
  <div class="abs serif it" style="left:72px;top:190px;font-size:190px;line-height:.94;letter-spacing:-.025em">Save this<br>for your<br><span class="gd">next site<br><span id="rev" style="display:inline-block">review.</span></span></div>
  <div class="abs serif" style="left:72px;top:1075px;width:900px;font-size:44px;line-height:1.2">Next in the series: the two-minute phone test.</div>
  <div class="abs mono" style="left:72px;top:1290px">Follow for Field Note № 02</div>
  <div class="abs mono" style="right:72px;top:1290px">{{ handle }}</div>
</div>

<div id="rule"></div>
<svg id="ruler" viewBox="0 0 {{ sw*n }} 46"></svg>
<svg id="ink" viewBox="0 0 {{ sw*n }} {{ sh }}"><path id="ring" fill="none" stroke="{{ extra.gold_deep }}" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" d=""/><path id="ring2" fill="none" stroke="{{ extra.gold_deep }}" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" d=""/><path id="arrow" fill="none" stroke="{{ extra.gold_deep }}" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" d=""/></svg>
<div id="grain"></div>
<script>
async function init(){
  await Promise.all([document.fonts.load('700 100px "Inter Display"'),document.fonts.load('400 100px "DM Serif Display"'),document.fonts.load('italic 400 100px "DM Serif Display"'),document.fonts.load('500 20px "DM Mono"'),document.fonts.load('400 20px "DM Sans"')]);
  // measuring ruler across the whole strip (continuous over every seam)
  const W={{ sw*n }};let r='';
  for(let x=0;x<=W;x+=36){const major=(x%180===0);r+='<line x1="'+x+'" x2="'+x+'" y1="'+(major?6:20)+'" y2="38" stroke="{{ extra.gold_deep }}" stroke-width="'+(major?2.5:1.5)+'"/>';}
  r+='<line x1="0" x2="'+W+'" y1="38" y2="38" stroke="{{ extra.gold_deep }}" stroke-width="2"/>';
  document.getElementById('ruler').innerHTML=r;
  // hand-drawn ring round "in order." that carries across the seam into slide 2 and ends in an arrow at the numeral
  const b=document.getElementById('inorder').getBoundingClientRect();
  const cx=b.left+b.width/2, cy=b.top+b.height/2+6, rx=b.width/2+34, ry=b.height/2+8;
  let d='';const steps=90;
  for(let i=0;i<=steps;i++){
    const a=-2.35+ (i/steps)*(Math.PI*2*1.04);
    const wob=1+0.025*Math.sin(a*3+1.2)+0.012*Math.sin(a*7);
    const sp=1+0.045*(i/steps);
    const x=cx+Math.cos(a)*rx*wob*sp, y=cy+Math.sin(a)*ry*wob*sp*0.98;
    d+=(i?' L':'M')+x.toFixed(1)+' '+y.toFixed(1);
  }
  document.getElementById('ring').setAttribute('d',d);
  const rv=document.getElementById('rev').getBoundingClientRect();
  {const rcx=rv.left+rv.width/2, rcy=rv.top+rv.height/2+8, rrx=rv.width/2+28, rry=rv.height/2+8;let d2='';
   for(let i=0;i<=90;i++){const a=-2.6+(i/90)*(Math.PI*2*1.04);const wob=1+0.025*Math.sin(a*3+0.4)+0.012*Math.sin(a*7);const sp=1+0.04*(i/90);
     d2+=(i?' L':'M')+(rcx+Math.cos(a)*rrx*wob*sp).toFixed(1)+' '+(rcy+Math.sin(a)*rry*wob*sp).toFixed(1);}
   document.getElementById('ring2').setAttribute('d',d2);}
  // tail: leaves the ring on the right, crosses the seam, curls down toward the big "1"
  const sx=cx+rx*1.05, sy=cy+ry*0.55, seam={{ sw }};
  const ex=seam+300, ey=520;
  document.getElementById('arrow').setAttribute('d','M'+sx.toFixed(0)+' '+sy.toFixed(0)+' C '+(seam-20)+' '+(sy+90)+', '+(seam+90)+' '+(ey-210)+', '+ex+' '+ey+' M '+(ex-30)+' '+(ey-34)+' L '+ex+' '+ey+' L '+(ex-44)+' '+(ey+12));
}
window.__ready=init();
</script></body></html>
