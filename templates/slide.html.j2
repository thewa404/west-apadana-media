{% extends "base.html.j2" %}
{#
  kind: statement | cover | point | compare | story | cta
  common: theme (obsidian|navy|graphite|ivory), kicker, index/total (carousel counter), swipe (bool), footer_right, ghost (big faint text)
  statement/cover: headline (list of lines, *accent* words), sub, size (headline px)
  point:   number, title, body
  compare: left_title, left_items, right_title, right_items, title
  story:   headline (list), paragraphs (list)
  cta:     headline (list), sub, button
#}
{% block theme %}t-{{ theme|default('obsidian') }}{% endblock %}
{% block css %}
.slide{position:absolute;inset:0;padding:84px 88px;display:flex;flex-direction:column;z-index:2}
.top,.bottom{display:flex;justify-content:space-between;align-items:center;font-size:26px;letter-spacing:.26em;text-transform:uppercase}
.top{font-weight:700}.top .brand{color:var(--gold)}.t-ivory .top .brand{color:var(--gold-deep)}
.bottom{font-weight:500;letter-spacing:.2em;opacity:.85}
.main{flex:1;display:flex;flex-direction:column;justify-content:{{ justify|default('flex-end') }};padding:40px 0 52px}
.kicker{font-size:30px;letter-spacing:.24em;text-transform:uppercase;font-weight:700;color:var(--gold);margin-bottom:34px}
.t-ivory .kicker{color:var(--gold-deep)}
h1{font-size:{{ size|default(150) }}px}
h2{font-size:{{ size|default(84) }}px}
.rule{width:132px;height:4px;background:var(--gold);margin:44px 0 38px}
.t-ivory .rule{background:var(--gold-deep)}
.sub{font-size:38px;line-height:1.42;max-width:820px;font-weight:400}
.frame{position:absolute;inset:44px;border:2px solid var(--gold);opacity:.26;pointer-events:none;z-index:1}
.t-ivory .frame{border-color:var(--gold-deep)}
.glow{position:absolute;right:-260px;top:-260px;width:820px;height:820px;border-radius:50%;background:radial-gradient(circle,rgba(198,166,106,.30),rgba(198,166,106,0) 66%);z-index:0}
.t-ivory .glow{background:radial-gradient(circle,rgba(138,106,47,.18),rgba(138,106,47,0) 66%)}
.ghost{position:absolute;right:-30px;bottom:-60px;font-size:700px;line-height:.8;opacity:.05;z-index:0;white-space:nowrap}
.num{font-size:230px;color:var(--gold);line-height:.82;margin-bottom:26px}
.t-ivory .num{color:var(--gold-deep)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:44px}
.col{border:2px solid rgba(242,237,228,.22);padding:40px 36px;min-height:520px}
.col h3{font-family:'Inter Display';font-weight:700;font-size:48px;letter-spacing:-.02em;margin-bottom:28px}
.col li{list-style:none;font-size:34px;line-height:1.35;margin-bottom:22px;padding-left:34px;position:relative}
.col li:before{content:"";position:absolute;left:0;top:.55em;width:14px;height:4px;background:currentColor}
.col.before{opacity:.6}.col.after{border-color:var(--gold);color:var(--ivory)}.col.after h3{color:var(--gold)}
.t-ivory .col{border-color:rgba(16,16,16,.25)}.t-ivory .col.after{border-color:var(--gold-deep);color:var(--obsidian)}.t-ivory .col.after h3{color:var(--gold-deep)}
.story p{font-size:38px;line-height:1.45;margin-bottom:28px;max-width:860px}
.pill{display:inline-flex;align-items:center;gap:18px;margin-top:46px;padding:28px 46px;border:3px solid var(--gold);border-radius:999px;font-size:34px;font-weight:700;letter-spacing:.06em;color:var(--gold);align-self:flex-start}
.t-ivory .pill{border-color:var(--gold-deep);color:var(--gold-deep)}
{% endblock %}
{% block body %}
<div class="glow"></div>
{% if ghost %}<div class="ghost display">{{ ghost }}</div>{% endif %}
<div class="frame"></div>
<div class="slide">
  <div class="top"><span class="brand">West Apadana</span><span>{% if total %}{{ '%02d'|format(index) }} / {{ '%02d'|format(total) }}{% endif %}</span></div>
  <div class="main">
  {% if kind in ('statement','cover') %}
    {% if kicker %}<div class="kicker">{{ kicker }}</div>{% endif %}
    <h1 class="display">{% for line in headline %}{{ line|mark }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>
    {% if sub %}<div class="rule"></div><div class="sub">{{ sub }}</div>{% endif %}
  {% elif kind == 'point' %}
    <div class="num display">{{ number }}</div>
    <h2 class="display">{{ title|mark }}</h2>
    <div class="rule"></div>
    <div class="sub">{{ body }}</div>
  {% elif kind == 'compare' %}
    {% if kicker %}<div class="kicker">{{ kicker }}</div>{% endif %}
    <h2 class="display">{{ title|mark }}</h2>
    <div class="cols">
      <div class="col before"><h3>{{ left_title }}</h3><ul>{% for it in left_items %}<li>{{ it }}</li>{% endfor %}</ul></div>
      <div class="col after"><h3>{{ right_title }}</h3><ul>{% for it in right_items %}<li>{{ it }}</li>{% endfor %}</ul></div>
    </div>
  {% elif kind == 'story' %}
    {% if kicker %}<div class="kicker">{{ kicker }}</div>{% endif %}
    <h2 class="display" style="font-size:{{ size|default(96) }}px">{% for line in headline %}{{ line|mark }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h2>
    <div class="rule"></div>
    <div class="story">{% for p in paragraphs %}<p>{{ p }}</p>{% endfor %}</div>
  {% elif kind == 'cta' %}
    {% if kicker %}<div class="kicker">{{ kicker }}</div>{% endif %}
    <h1 class="display" style="font-size:{{ size|default(120) }}px">{% for line in headline %}{{ line|mark }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>
    {% if sub %}<div class="rule"></div><div class="sub">{{ sub }}</div>{% endif %}
    {% if button %}<div class="pill">{{ button }} <span>→</span></div>{% endif %}
  {% endif %}
  </div>
  <div class="bottom"><span>{{ handle }}</span><span>{% if swipe %}Swipe →{% else %}{{ footer_right|default('') }}{% endif %}</span></div>
</div>
{% endblock %}
